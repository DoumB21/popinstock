<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local-IIS-only equivalent of the routing vercel.json already defines for
  production (cleanUrls + the /collection, /template, and /inventory path
  rewrites).
  This file has no effect on Vercel — it only exists so http://localhost/...
  behaves the same as the live site when serving this folder through IIS.
  If vercel.json's rewrites ever change, mirror the change here too — EXCEPT
  the .html extension on the rewrite targets below: IIS's type="Rewrite"
  serves the physical file directly (target keeps .html, browser URL bar
  doesn't change), unlike Vercel, whose rewrite destination re-enters the
  same cleanUrls-aware routing pipeline and therefore must NOT include
  .html (confirmed 2026-07-27 — vercel.json's rewrites 404'd in production
  until .html was dropped from their destinations; that's a Vercel-specific
  requirement, not a general one, so don't propagate it here).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Direct /foo.html hit -> redirect to the clean /foo URL (mirrors
             Vercel's automatic cleanUrls redirect). Temporary (302) so the
             browser doesn't cache it aggressively while iterating locally. -->
        <rule name="Redirect .html to clean URL" stopProcessing="true">
          <match url="^(.*)\.html$" />
          <conditions>
            <add input="{REQUEST_METHOD}" pattern="GET" />
          </conditions>
          <action type="Redirect" url="{R:1}" redirectType="Temporary" appendQueryString="true" />
        </rule>

        <!-- /collection/XXXX -> collection.html?collection_name=XXXX -->
        <rule name="Collection clean URL" stopProcessing="true">
          <match url="^collection/([^/]+)$" />
          <action type="Rewrite" url="collection.html?collection_name={R:1}" appendQueryString="true" />
        </rule>

        <!-- /template/XXXX -> template.html?template_id=XXXX -->
        <rule name="Template clean URL" stopProcessing="true">
          <match url="^template/([^/]+)$" />
          <action type="Rewrite" url="template.html?template_id={R:1}" appendQueryString="true" />
        </rule>

        <!-- /inventory/XXXX -> inventory.html?wallet=XXXX -->
        <rule name="Inventory clean URL" stopProcessing="true">
          <match url="^inventory/([^/]+)$" />
          <action type="Rewrite" url="inventory.html?wallet={R:1}" appendQueryString="true" />
        </rule>

        <!-- /asset/XXXX -> asset.html?asset_id=XXXX -->
        <rule name="Asset clean URL" stopProcessing="true">
          <match url="^asset/([^/]+)$" />
          <action type="Rewrite" url="asset.html?asset_id={R:1}" appendQueryString="true" />
        </rule>

        <!-- /schema/XXXX/YYYY -> schema.html?collection_name=XXXX&schema_name=YYYY -->
        <rule name="Schema clean URL" stopProcessing="true">
          <match url="^schema/([^/]+)/([^/]+)$" />
          <action type="Rewrite" url="schema.html?collection_name={R:1}&amp;schema_name={R:2}" appendQueryString="true" />
        </rule>

        <!-- /sale/XXXX -> sale.html?sale_id=XXXX -->
        <rule name="Sale clean URL" stopProcessing="true">
          <match url="^sale/([^/]+)$" />
          <action type="Rewrite" url="sale.html?sale_id={R:1}" appendQueryString="true" />
        </rule>

        <!-- Everything else: /foo -> foo.html (or /path/foo -> path/foo.html)
             when that .html file actually exists on disk. -->
        <rule name="Clean URL to .html file" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.html" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
