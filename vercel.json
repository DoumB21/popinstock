{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "hoardio.com" }],
      "destination": "https://www.hoardio.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "popinstock.com" }],
      "destination": "https://www.popinstock.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/collection/:name", "destination": "/collection?collection_name=:name" },
    { "source": "/template/:id", "destination": "/template?template_id=:id" },
    { "source": "/inventory/:wallet", "destination": "/inventory?wallet=:wallet" },
    { "source": "/asset/:id", "destination": "/asset?asset_id=:id" },
    { "source": "/schema/:collection/:name", "destination": "/schema?collection_name=:collection&schema_name=:name" },
    { "source": "/sale/:id", "destination": "/sale?sale_id=:id" },
    { "source": "/profile/:tab", "destination": "/profile?tab=:tab" },
    { "source": "/nhlbreakaway/holders/:id", "destination": "/nhlbreakaway/holders?moment_uuid=:id" },
    { "source": "/api/:path*", "destination": "/api/route" }
  ],
  "functions": {
    "api/og-page/collection.js": { "includeFiles": "collection.html" },
    "api/og-page/template.js": { "includeFiles": "template.html" },
    "api/og-page/inventory.js": { "includeFiles": "inventory.html" }
  }
}
